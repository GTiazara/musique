---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChordDiagrams from '../../components/ChordDiagrams.vue';
import TabPlayer from '../../components/TabPlayer.vue';
import {
  capoLabel,
  diagramsFor,
  formatKey,
  publishedMorceaux,
  sortByUpdatedDesc,
  toSearchDocument,
} from '../../lib/morceaux';
import { withBase } from '../../lib/paths';

/**
 * Pages des morceaux publiés seulement.
 * Un brouillon n'a pas d'adresse : la page introuvable répond à sa place.
 */
export async function getStaticPaths() {
  const published = publishedMorceaux(await getCollection('morceaux'));
  return published.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const ordered = sortByUpdatedDesc(publishedMorceaux(await getCollection('morceaux')));
const position = ordered.findIndex((item) => item.id === slug);
const entry = ordered[position];
if (!entry) {
  throw new Error(`Morceau publié introuvable : ${slug}`);
}
const newer = ordered[position - 1];
const older = ordered[position + 1];
const card = toSearchDocument(entry, import.meta.env.BASE_URL);
const diagrams = diagramsFor(entry);
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const keyInfo = formatKey(entry.data.key);
const hasCapo = entry.data.capo > 0;
const capoText = capoLabel(entry.data.capo, entry.data.capoNote);
const links = [
  ['Écouter', entry.data.youtube, ''],
  ['Tutoriel', entry.data.tutorial, 'secondary'],
  ['Autre source', entry.data.sheet, 'secondary'],
].filter((item): item is [string, string, string] => Boolean(item[1]));
---
<Base title={`${card.title} — Guitarothèque`} description={card.description}>
  <article class="fiche-article">
    <a class="back-link" href={withBase('/morceaux', base)}>← Tous les morceaux</a>
    <header class="fiche-header">
      <p class="fiche-kicker">
        <a href={withBase(`/categories/${entry.data.category}`, base)}>{card.categoryLabel}</a>
        <span class="pill">{card.difficultyLabel}</span>
        <span class:list={['pill', { done: entry.data.status === 'maitrise' }]}>{card.statusLabel}</span>
        {keyInfo && <span class="pill pill-key" title={`Tonalité : ${keyInfo.fullName}`}>🎵 {keyInfo.code}</span>}
        {hasCapo ? (
          <span class="pill pill-capo" title={`Capodastre en case ${entry.data.capo}`}>🎯 Capo {entry.data.capo}</span>
        ) : (
          <span class="pill" title="Aucun capodastre">Sans capo</span>
        )}
      </p>

      <h1>{card.title}</h1>
      <p class="artist">{card.artist}</p>

      <!-- PANNEAU CONFIGURATION DE JEU (TONALITÉ & CAPODASTRE) -->
      <section class="fiche-setup" aria-label="Configuration de jeu">
        <div class="setup-grid">
          <!-- Tonalité (Clé) -->
          <div class="setup-card setup-card-key">
            <div class="setup-header">
              <span class="setup-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 18V5l12-2v13"></path>
                  <circle cx="6" cy="18" r="3"></circle>
                  <circle cx="18" cy="16" r="3"></circle>
                </svg>
              </span>
              <span class="setup-label">Tonalité (Clé)</span>
            </div>
            <div class="setup-body">
              {keyInfo ? (
                <div class="key-display">
                  <span class="key-badge">{keyInfo.code}</span>
                  <span class="key-name">{keyInfo.name}</span>
                </div>
              ) : (
                <div class="key-display">
                  <span class="key-badge neutral">—</span>
                  <span class="key-name">Non spécifiée</span>
                </div>
              )}
            </div>
          </div>

          <!-- Capodastre -->
          <div class:list={['setup-card', 'setup-card-capo', { 'highlight-capo': hasCapo }]}>
            <div class="setup-header">
              <span class="setup-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <line x1="8" y1="5" x2="8" y2="19"></line>
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="16" y1="5" x2="16" y2="19"></line>
                  <path d="M12 2v3M12 19v3"></path>
                </svg>
              </span>
              <span class="setup-label">Capodastre</span>
            </div>
            <div class="setup-body">
              {hasCapo ? (
                <div class="capo-display">
                  <span class="capo-badge-active">
                    <span class="capo-badge-dot" aria-hidden="true"></span>
                    Case {entry.data.capo}
                  </span>
                  <span class="capo-subtext">Fret {entry.data.capo}</span>
                </div>
              ) : (
                <div class="capo-display">
                  <span class="capo-badge-none">Sans capodastre</span>
                  <span class="capo-subtext">Accordage standard</span>
                </div>
              )}
            </div>
          </div>
        </div>

        {entry.data.capoNote && (
          <div class="setup-note">
            <span class="setup-note-icon" aria-hidden="true">💡</span>
            <div class="setup-note-content">
              <strong>Conseil de jeu :</strong> {entry.data.capoNote}
            </div>
          </div>
        )}
      </section>

      <p class="lead">{card.description}</p>
    </header>
    {links.length > 0 && (
      <p class="detail-links">
        {links.map(([label, href, kind]) => (
          <a class={kind} href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a>
        ))}
      </p>
    )}
    {diagrams.length > 0 && (
      <section class="chord-diagrams-section">
        <h2>Accords du morceau</h2>
        {hasCapo ? (
          <p class="note">
            🎯 <strong>Capodastre en case {entry.data.capo} :</strong> les diagrammes ci-dessous indiquent les positions relatives au capo (la case 0 correspond au capo).
          </p>
        ) : (
          <p class="note">Les diagrammes ci-dessous indiquent les positions en accordage standard (sans capodastre).</p>
        )}
        <ChordDiagrams client:load diagrams={diagrams} />
      </section>
    )}
    <div class="reading">
      <Content />
    </div>
    <TabPlayer client:load capo={entry.data.capo} />
    {(newer || older) && (
      <nav class="fiche-pager" aria-label="Autres morceaux">
        {newer ? (
          <a href={withBase(`/morceaux/${newer.id}`, base)}>
            <span class="artist">← Plus récent</span>
            <strong>{newer.data.title}</strong>
          </a>
        ) : <span />}
        {older ? (
          <a class="next" href={withBase(`/morceaux/${older.id}`, base)}>
            <span class="artist">Plus ancien →</span>
            <strong>{older.data.title}</strong>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</Base>
