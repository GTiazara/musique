---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SongCard from '../../components/SongCard.astro';
import SongFilters from '../../components/SongFilters.vue';
import { categories } from '../../data/categories';
import { publishedMorceaux, sortByUpdatedDesc, toSearchDocument } from '../../lib/morceaux';

/**
 * Une page par catégorie déclarée, même encore vide.
 * Le slug vient de la liste du projet, pas du nom d'un fichier.
 */
export function getStaticPaths() {
  return categories.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const category = categories.find((item) => item.slug === slug);
if (!category) {
  throw new Error(`Catégorie inconnue : ${slug}`);
}
const published = sortByUpdatedDesc(publishedMorceaux(await getCollection('morceaux'))).filter(
  (entry) => entry.data.category === slug,
);
const cards = published.map((entry) => toSearchDocument(entry, import.meta.env.BASE_URL));
---
<Base title={`${category.label} — Guitarothèque`} description={`Morceaux classés dans ${category.label}.`}>
  <h1>{category.label}</h1>
  <SongFilters
    client:load
    listId="catalogue"
    emptyId="catalogue-vide"
    showCategory={false}
    categories={[]}
  />
  <p id="catalogue-vide" class="empty" hidden>Aucun morceau ne correspond à ces filtres.</p>
  {cards.length === 0 ? (
    <p class="empty">Aucun morceau publié dans cette catégorie.</p>
  ) : (
    <ul id="catalogue" class="card-grid">
      {cards.map((card) => (
        <SongCard
          title={card.title}
          artist={card.artist}
          description={card.description}
          category={card.category}
          categoryLabel={card.categoryLabel}
          difficulty={card.difficulty}
          difficultyLabel={card.difficultyLabel}
          status={card.status}
          statusLabel={card.statusLabel}
          chords={card.chords}
          href={card.href}
          keyName={card.key}
          capo={card.capo}
        />
      ))}
    </ul>
  )}
</Base>
